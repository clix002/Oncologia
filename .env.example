# =============================================================
# INEN Oncología — BI Dashboard Perú
# Variables de entorno para docker compose
#
# Uso:
#   cp .env.example .env
#   # Editá las contraseñas antes de usar en producción
#   docker compose up -d
# =============================================================

# ── Red interna ───────────────────────────────────────────────
NETWORK_SUBNET=172.28.0.0/16

# ── PostgreSQL OLTP (Base Transaccional) ──────────────────────
# Conexión externa: postgresql://oncologia:password@localhost:5433/oncologia_oltp
# Conexión interna (entre containers): host=postgres_oltp port=5432
POSTGRES_OLTP_USER=oncologia
POSTGRES_OLTP_PASSWORD=oncologia_dev_2026
POSTGRES_OLTP_DB=oncologia_oltp
POSTGRES_OLTP_PORT=5433

# ── PostgreSQL OLAP (Data Warehouse) ──────────────────────────
# Conexión externa: postgresql://oncologia:password@localhost:5434/oncologia_olap
# Conexión interna: host=postgres_olap port=5432
POSTGRES_OLAP_USER=oncologia
POSTGRES_OLAP_PASSWORD=oncologia_dev_2026
POSTGRES_OLAP_DB=oncologia_olap
POSTGRES_OLAP_PORT=5434

# ── MongoDB (NoSQL Documental) ────────────────────────────────
# Conexión externa: mongodb://admin:password@localhost:27018/oncologia_docs?authSource=admin
# Conexión interna: mongodb://admin:password@mongodb:27017
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=admin_dev_2026
MONGO_PORT=27018

# ── Redis (Caché In-Memory) ───────────────────────────────────
# Conexión externa: redis://localhost:6380
# Conexión interna: redis://redis:6379
REDIS_PORT=6380

# ── Neo4j (Base de Datos de Grafos) ───────────────────────────
# Browser:          http://localhost:7475
# Conexión Bolt:    bolt://localhost:7688
# Conexión interna: bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=oncologia_graph_2026
NEO4J_HTTP_PORT=7475
NEO4J_BOLT_PORT=7688

# ── MinIO (Data Lake — S3 compatible) ─────────────────────────
# Consola web: http://localhost:9002
# API S3:      http://localhost:9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_2026
MINIO_API_PORT=9001
MINIO_CONSOLE_PORT=9002

# ── Ollama (LLM Local) ────────────────────────────────────────
# API: http://localhost:11435
# Modelos usados: gemma3:1b, nomic-embed-text
# Para descargar modelos luego de iniciar:
#   docker exec oncologia-ollama ollama pull gemma3:1b
#   docker exec oncologia-ollama ollama pull nomic-embed-text
OLLAMA_PORT=11435

# ── Python Analytics (Minería + NLP) ──────────────────────────
# API: http://localhost:8001/docs  (FastAPI con Swagger)
PYTHON_ANALYTICS_PORT=8001

# ── Next.js Frontend ──────────────────────────────────────────
# App: http://localhost:3000
NEXTJS_PORT=3000

# ── Gemini API (opcional — fallback si Ollama no responde) ────
# Obtené tu key en: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your-key-here
