{
  "name": "oncologia-bi",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "init": "bun run scripts/init.ts",
    "dev": "bun run scripts/dev.ts",
    "build": "next build",
    "start": "next start",
    "lint": "npx @biomejs/biome check app/api/ app/page.tsx app/layout.tsx app/arquitectura/ components/ lib/",
    "etl": "bun run --cwd apps/etl all",
    "etl:oltp": "bun run --cwd apps/etl load-oltp",
    "etl:olap": "bun run --cwd apps/etl load-olap",
    "etl:sinadef": "bun run --cwd apps/etl load-sinadef",
    "etl:mongo": "bun run --cwd apps/etl load-mongo",
    "etl:neo4j": "bun run --cwd apps/etl load-neo4j",
    "services": "podman compose -f docker/podman-compose.yml up -d",
    "services:down": "podman compose -f docker/podman-compose.yml down",
    "turbo": "turbo"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@libsql/client": "^0.17.2",
    "arquero": "^8.0.3",
    "better-sqlite3": "^12.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "postgres": "^3.4.9",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.0",
    "shadcn": "^4.0.5",
    "simple-statistics": "^7.8.9",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.11",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "turbo": "^2.5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "better-sqlite3",
    "sharp",
    "unrs-resolver",
    "turbo"
  ]
}
